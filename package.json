{
  "name": "adblock",
  "version": "1.0.1",
  "private": true,
  "description": "Chrome MV3 ad blocker: AdGuard DNR rulesets + cosmetic CSS, YouTube scriptlets, Twitch stream swap",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:release": "node build.mjs --release",
    "vendor": "node build.mjs --vendor",
    "test": "node test/twitch-playlists.mjs",
    "smoke": "node test/smoke.mjs",
    "probe": "node test/twitch-probe.mjs",
    "verify": "node test/verify.mjs",
    "verify:generic": "node test/verify.mjs generic",
    "verify:youtube": "node test/verify.mjs youtube",
    "verify:twitch": "node test/verify.mjs twitch"
  },
  "devDependencies": {
    "@adguard/dnr-rulesets": "5.0.20261013160024",
    "@adguard/scriptlets": "2.5.1",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/getFran/AdBlock.git"
  }
}
